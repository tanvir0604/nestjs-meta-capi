{
  "name": "nestjs-meta-capi",
  "version": "1.0.0",
  "description": "Idiomatic NestJS integration for the Meta Conversions API, powered by Meta's official Node.js Business SDK.",
  "keywords": [
    "nestjs",
    "nest",
    "nest-module",
    "meta",
    "facebook",
    "conversions-api",
    "capi",
    "meta-capi",
    "facebook-conversions-api",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanvir0604/nestjs-meta-capi.git"
  },
  "homepage": "https://github.com/tanvir0604/nestjs-meta-capi#readme",
  "bugs": {
    "url": "https://github.com/tanvir0604/nestjs-meta-capi/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p examples/tsconfig.json --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:cov": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:live": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testMatch \"**/*.live.spec.ts\" --testPathIgnorePatterns \"/node_modules/\"",
    "format": "prettier --write \"{src,test,examples}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test,examples}/**/*.ts\"",
    "pack:check": "npm pack --dry-run",
    "release": "npm run lint && npm run format:check && npm run typecheck && npm run test:cov && npm run build && npm run pack:check",
    "prepublishOnly": "npm run release"
  },
  "dependencies": {
    "capi-param-builder-nodejs": "^1.3.2",
    "facebook-nodejs-business-sdk": "^24.0.1"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0 || ^12.0.0",
    "@nestjs/core": "^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.1.12 || ^0.2.0",
    "rxjs": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/platform-express": "^12.1.1",
    "@nestjs/platform-fastify": "^12.1.1",
    "@nestjs/testing": "^12.1.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.4.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
